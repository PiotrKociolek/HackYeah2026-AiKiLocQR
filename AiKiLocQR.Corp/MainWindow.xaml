<Window x:Class="AiKiLocQR.Corp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiKiLocQR - Odbiorca (Korporacja)" Height="500" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- PANEL 1: AUTORYZACJA KLUCZA -->
        <Grid x:Name="PanelAuth" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Krok 1: Autoryzacja MasterKey" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" />
                <TextBlock Text="Zanim odszyfrujesz paczkę, załącz swój sprzętowy klucz MasterKey." FontSize="16" Margin="0,0,0,30" HorizontalAlignment="Center" />
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                    <Button x:Name="BtnLoadKey" Content="Załącz plik klucza z dysku" Width="220" Height="50" FontSize="14" Click="BtnLoadKey_Click" />
                    <Button x:Name="BtnGenerateKey" Content="Wygeneruj nowy MasterKey" Width="220" Height="50" FontSize="14" Click="BtnGenerateKey_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- PANEL 2: DESZYFRACJA -->
        <Grid x:Name="PanelDecrypt" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Krok 2: Odszyfrowywanie paczki" FontSize="26" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtKeyStatus" Text="Zalogowano. Aktywny klucz: " Foreground="Green" Margin="0,0,0,30" HorizontalAlignment="Center" />
                
                <TextBlock Text="Wybierz bezpieczną paczkę (.aikilocpkg) otrzymaną od klienta:" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center" />
                <Button x:Name="BtnSelectPackage" Content="Wybierz i odszyfruj plik" Width="250" Height="60" FontSize="16" Background="#FF4CAF50" Foreground="White" Click="BtnSelectPackage_Click"/>
                
                <Button x:Name="BtnLogout" Content="Wyloguj (Zmień klucz)" Width="150" Height="30" Margin="0,40,0,0" Background="Transparent" BorderBrush="Gray" Click="BtnLogout_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
