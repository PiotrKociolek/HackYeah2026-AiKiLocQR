<Window x:Class="AiKiLocQR.Corp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiKiLocQR - Odbiorca (Korporacja)" Height="450" Width="600">
    <Grid>
        <TabControl x:Name="MainTabs">
            <TabItem Header="Dashboard">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="AiKiLocQR Offline Security Vault" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />
                    <TextBlock Text="Włóż swój MasterKey USB do komputera, a następnie odszyfruj paczki od klientów." FontSize="14" />
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Decrypt Package">
                <StackPanel Margin="20" HorizontalAlignment="Center">
                    <TextBlock Text="Odszyfrowywanie paczki" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />
                    <Button x:Name="BtnSelectPackage" Content="Wybierz i odszyfruj plik .aikilocpkg" Width="250" Height="50" FontSize="14" Background="#FF4CAF50" Foreground="White" Click="BtnSelectPackage_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
