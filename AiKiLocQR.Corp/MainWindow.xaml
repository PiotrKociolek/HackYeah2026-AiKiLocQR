<Window x:Class="AiKiLocQR.Corp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiKiLocQR - Odbiorca (Korporacja)"
        Height="580" Width="780" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#0A0A0A" Offset="0.7"/>
            <GradientStop Color="#050505" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Paleta: czerń + złoto -->
        <SolidColorBrush x:Key="GoldBrush" Color="#C9A24B"/>
        <SolidColorBrush x:Key="GoldLightBrush" Color="#E6CB86"/>
        <SolidColorBrush x:Key="CardBrush" Color="#121212"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3A2F18"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EDE7D8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8C8576"/>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6CB86" Offset="0"/>
            <GradientStop Color="#C9A24B" Offset="0.55"/>
            <GradientStop Color="#A9822E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2DB9C" Offset="0"/>
            <GradientStop Color="#D8B35C" Offset="0.55"/>
            <GradientStop Color="#B8903A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Przycisk złoty (główny) -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource GoldGradient}"
                                CornerRadius="6" Padding="24,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#C9A24B" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldGradientHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Przycisk konturowy złoty -->
        <Style x:Key="GoldOutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.2"
                                CornerRadius="6" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22C9A24B"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38C9A24B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link-przycisk (wylogowanie) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#14C9A24B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GoldRule" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Fill" Value="{StaticResource GoldBrush}"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- PANEL 1: AUTORYZACJA KLUCZA -->
        <Grid x:Name="PanelAuth" Visibility="Visible">
            <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="40,40,40,36">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#C9A24B" Opacity="0.10"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="K R O K   1" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Autoryzacja MasterKey" Style="{StaticResource Heading}"/>
                    <Rectangle Style="{StaticResource GoldRule}"/>
                    <TextBlock Text="Zanim odszyfrujesz paczkę, załącz swój sprzętowy klucz MasterKey."
                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,32"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLoadKey" Grid.Column="0" Height="52"
                                Content="Załącz plik klucza"
                                Style="{StaticResource GoldButton}" Click="BtnLoadKey_Click"/>
                        <Button x:Name="BtnGenerateKey" Grid.Column="2" Height="52"
                                Content="Wygeneruj nowy klucz"
                                Style="{StaticResource GoldOutlineButton}" Click="BtnGenerateKey_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PANEL 2: DESZYFRACJA -->
        <Grid x:Name="PanelDecrypt" Visibility="Collapsed">
            <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="40,40,40,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#C9A24B" Opacity="0.10"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="K R O K   2" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Odszyfrowywanie paczki" Style="{StaticResource Heading}"/>
                    <Rectangle Style="{StaticResource GoldRule}" Margin="0,18,0,16"/>

                    <!-- Status klucza -->
                    <Border Background="#1A1608" BorderBrush="#3A2F18" BorderThickness="1"
                            CornerRadius="16" Padding="14,6" HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#C9A24B" Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtKeyStatus" Text="Zalogowano. Aktywny klucz: "
                                       Foreground="{StaticResource GoldLightBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Wybierz bezpieczną paczkę (.aikilocpkg) otrzymaną od klienta"
                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

                    <Button x:Name="BtnSelectPackage" Content="Wybierz i odszyfruj plik"
                            Height="56" Width="300" Style="{StaticResource GoldButton}"
                            Click="BtnSelectPackage_Click"/>

                    <Button x:Name="BtnLogout" Content="Wyloguj (zmień klucz)"
                            Margin="0,26,0,0" HorizontalAlignment="Center"
                            Style="{StaticResource GhostButton}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
