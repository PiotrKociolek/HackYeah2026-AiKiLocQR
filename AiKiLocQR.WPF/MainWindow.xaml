<Window x:Class="AiKiLocQR.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiKiLocQR Vault" Height="600" Width="800">
    <Grid>
        <TabControl x:Name="MainTabs">
            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="AiKiLocQR Offline Security Vault" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />
                    <TextBlock Text="Welcome to your secure offline package manager." FontSize="16" />
                </StackPanel>
            </TabItem>
            
            <!-- Encrypt -->
            <TabItem Header="Encrypt Files">
                <StackPanel Margin="20">
                    <TextBlock Text="1. Select files to encrypt" FontSize="18" FontWeight="Bold" />
                    <Button x:Name="BtnSelectFiles" Content="Select Files" Width="150" Height="40" Margin="0,10,0,20" Click="BtnSelectFiles_Click"/>
                    <ListBox x:Name="ListSelectedFiles" Height="100" Margin="0,0,0,20" />
                    <TextBlock Text="2. Create Encrypted Package" FontSize="18" FontWeight="Bold" />
                    <Button x:Name="BtnEncrypt" Content="Encrypt to .aikilocpkg" Width="200" Height="40" Margin="0,10,0,0" Click="BtnEncrypt_Click"/>
                </StackPanel>
            </TabItem>
            
            <!-- Decrypt -->
            <TabItem Header="Decrypt Package">
                <StackPanel Margin="20">
                    <TextBlock Text="1. Select Package" FontSize="18" FontWeight="Bold" />
                    <Button x:Name="BtnSelectPackage" Content="Select .aikilocpkg" Width="150" Height="40" Margin="0,10,0,20" Click="BtnSelectPackage_Click"/>
                    <TextBlock x:Name="TxtSelectedPackage" Text="None selected" Foreground="Gray" Margin="0,0,0,20" />
                    
                    <TextBlock Text="2. QR Authorization" FontSize="18" FontWeight="Bold" />
                    <Image x:Name="ImgQrChallenge" Width="200" Height="200" Margin="0,10,0,10" />
                    
                    <TextBlock Text="Scan with Android and paste Signature below (Simulation):" Margin="0,10,0,5" />
                    <TextBox x:Name="TxtQrResponse" Height="30" Margin="0,0,0,10" />
                    
                    <Button x:Name="BtnVerifyAndDecrypt" Content="Verify Response &amp; Decrypt" Width="200" Height="40" Click="BtnVerifyAndDecrypt_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
